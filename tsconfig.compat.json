{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["bun"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"noUncheckedIndexedAccess": true,
		// The package's own examples import it by name; resolve that to the sources, not dist.
		"paths": {
			"eumenes-memory": ["./src/index.ts"],
			"eumenes-memory/sqlite": ["./src/sqlite.ts"]
		}
	},
	"include": ["src"],
	"exclude": ["src/**/test/**"]
}
