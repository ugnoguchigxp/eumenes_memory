{
	"name": "eumenes-memory",
	"version": "0.0.2",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./sqlite": {
			"types": "./dist/sqlite.d.ts",
			"default": "./dist/sqlite.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepack": "bun run build",
		"check:memory": "bun examples/standalone/main.ts",
		"check:memory:live": "bun examples/standalone/main.ts --live",
		"check:memory:conversations": "bun examples/standalone/main.ts --suite conversation",
		"check:memory:conversations:live": "bun examples/standalone/main.ts --suite conversation --live",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:domain": "bun scripts/test-domain.ts",
		"check:boundaries": "bun scripts/boundaries.ts",
		"verify": "bun scripts/verify.ts",
		"verify:all": "bun scripts/verify.ts --all",
		"memory": "bun examples/standalone/memory.ts",
		"memory:seed": "bun examples/seeds/main.ts"
	},
	"devDependencies": {
		"@openai/codex-sdk": "0.163.0",
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"typescript": "5.9.3"
	}
}
