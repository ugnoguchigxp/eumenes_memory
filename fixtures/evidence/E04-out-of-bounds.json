{
	"id": "E04-out-of-bounds",
	"fixtureFormat": 1,
	"covers": [
		"range"
	],
	"description": "end beyond the content, and any range on empty content",
	"steps": [
		{
			"op": "capture",
			"origin": "o1",
			"content": "abc"
		},
		{
			"op": "range",
			"origin": "o1",
			"start": 0,
			"end": 4,
			"expect": {
				"status": "invalid_range",
				"reasonCode": "SOURCE_RANGE_OUT_OF_BOUNDS"
			}
		},
		{
			"op": "range",
			"origin": "o1",
			"start": 3,
			"end": 4,
			"expect": {
				"status": "invalid_range",
				"reasonCode": "SOURCE_RANGE_OUT_OF_BOUNDS"
			}
		},
		{
			"op": "range",
			"origin": "o1",
			"start": 2,
			"end": 3,
			"expect": {
				"status": "available",
				"text": "c",
				"digest": "2e7d2c03a9507ae265ecf5b5356885a53393a2029d241394997265a1a25aefc6"
			}
		},
		{
			"op": "capture",
			"origin": "o2",
			"content": ""
		},
		{
			"op": "range",
			"origin": "o2",
			"start": 0,
			"end": 1,
			"expect": {
				"status": "invalid_range",
				"reasonCode": "SOURCE_RANGE_OUT_OF_BOUNDS"
			}
		}
	]
}
