{
	"id": "R12-large-scope-uses-fts",
	"fixtureFormat": 1,
	"covers": [
		"fts",
		"strategy"
	],
	"description": "More than LIKE_SCAN_MAX (5000) active records in the searched scopes selects FTS for 3+ character queries; short queries stay on LIKE",
	"steps": [
		{
			"op": "bulk",
			"scope": "scope:c",
			"count": 5001,
			"template": "filler row {n} nothing to see"
		},
		{
			"op": "capture",
			"origin": "target",
			"content": "the needle is hidden in this one",
			"scope": "scope:a"
		},
		{
			"op": "search",
			"scopes": [
				"scope:a",
				"scope:c"
			],
			"query": "needle hidden",
			"expect": {
				"status": "ok",
				"origins": [
					"target@scope:a"
				],
				"natural": "fts"
			}
		},
		{
			"op": "search",
			"scopes": [
				"scope:a",
				"scope:c"
			],
			"query": "ne",
			"expect": {
				"status": "ok",
				"origins": [
					"target@scope:a"
				],
				"natural": "like"
			}
		},
		{
			"op": "search",
			"scopes": [
				"scope:a"
			],
			"query": "needle hidden",
			"expect": {
				"status": "ok",
				"origins": [
					"target@scope:a"
				],
				"natural": "like"
			}
		}
	]
}
