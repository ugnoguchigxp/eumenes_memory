{
	"id": "R06-scope-isolation",
	"fixtureFormat": 1,
	"covers": [
		"access"
	],
	"description": "Other scopes never appear; the same text in two scopes is two records",
	"steps": [
		{
			"op": "capture",
			"origin": "o1",
			"content": "shared phrase here",
			"scope": "scope:a"
		},
		{
			"op": "capture",
			"origin": "o1",
			"content": "shared phrase here",
			"scope": "scope:b"
		},
		{
			"op": "capture",
			"origin": "o2",
			"content": "shared phrase elsewhere",
			"scope": "scope:c"
		},
		{
			"op": "search",
			"scopes": [
				"scope:a"
			],
			"query": "shared phrase",
			"expect": {
				"status": "ok",
				"origins": [
					"o1@scope:a"
				],
				"natural": "like"
			}
		},
		{
			"op": "search",
			"scopes": [
				"scope:b"
			],
			"query": "shared phrase",
			"expect": {
				"status": "ok",
				"origins": [
					"o1@scope:b"
				],
				"natural": "like"
			}
		},
		{
			"op": "search",
			"scopes": [
				"scope:b",
				"scope:a"
			],
			"query": "shared phrase",
			"expect": {
				"status": "ok",
				"origins": [
					"o1@scope:b",
					"o1@scope:a"
				],
				"natural": "like"
			}
		},
		{
			"op": "search",
			"scopes": [
				"scope:a",
				"scope:b",
				"scope:c"
			],
			"query": "elsewhere",
			"expect": {
				"status": "ok",
				"origins": [
					"o2@scope:c"
				],
				"natural": "like"
			}
		}
	]
}
