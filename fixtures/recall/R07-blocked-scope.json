{
	"id": "R07-blocked-scope",
	"fixtureFormat": 1,
	"covers": [
		"access"
	],
	"description": "A scope outside the access is blocked (a result, not an exception)",
	"steps": [
		{
			"op": "capture",
			"origin": "o1",
			"content": "visible body"
		},
		{
			"op": "search",
			"scopes": [
				"scope:a",
				"scope:z"
			],
			"query": "visible",
			"expect": {
				"status": "blocked",
				"reasonCode": "SCOPE_NOT_PERMITTED"
			}
		},
		{
			"op": "search",
			"scopes": [
				"scope:a"
			],
			"principal": "local:other",
			"query": "visible",
			"expect": {
				"status": "ok",
				"origins": [],
				"natural": "like"
			}
		}
	]
}
