{
  "fixtureFormat": 1,
  "id": "X31-user-confirmed-active-is-protected",
  "covers": [
    "user-confirmed",
    "pending_user",
    "preference-change",
    "safety"
  ],
  "provenance": [
    "本設計 full-system-design §3.6 Extraction",
    "本設計 §6.4(a) 日本語の決定的 fixture（モデルは使わない。canned output）"
  ],
  "description": "S3 報告 #3: 抽出由来（auto_admit でも）はユーザー確認済みの active を黙って上書きしない。確認すると CAS で置き換わる",
  "sources": [
    {
      "name": "m1",
      "role": "user",
      "ordinal": 5,
      "content": "私はコーヒーが好きです。毎朝飲みます。"
    },
    {
      "name": "m2",
      "role": "user",
      "ordinal": 8,
      "content": "最近は紅茶が好きになった🍵。"
    }
  ],
  "steps": [
    {
      "op": "assert-state",
      "as": "s1",
      "semanticKey": "drink",
      "text": "コーヒー",
      "source": "m1",
      "quote": "コーヒーが好き"
    },
    {
      "op": "prepare",
      "run": "j1",
      "expect": {
        "status": "ready",
        "shown": [
          "s1"
        ]
      },
      "sources": [
        "m2"
      ]
    },
    {
      "op": "settle",
      "run": "j1",
      "output": {
        "noChange": false,
        "candidates": [
          {
            "kind": "preference",
            "subject": "self",
            "semanticKey": "drink",
            "value": {
              "text": "紅茶",
              "polarity": "affirmed"
            },
            "modality": "asserted",
            "temporal": "current",
            "evidence": [
              {
                "source": "m2",
                "quote": "紅茶が好き"
              }
            ],
            "replaces": "@s1"
          }
        ]
      },
      "policy": {
        "all": "auto_admit"
      },
      "expect": {
        "status": "applied",
        "admitted": 0,
        "pendingUser": 1,
        "rejected": 0
      }
    },
    {
      "op": "list-state",
      "expect": {
        "items": [
          {
            "semanticKey": "drink",
            "status": "active",
            "origin": "user_confirmed",
            "text": "コーヒー",
            "polarity": "affirmed"
          }
        ]
      }
    },
    {
      "op": "list-candidates",
      "expect": {
        "count": 1,
        "items": [
          {
            "decision": "pending_user",
            "reasonCode": "POLICY_REQUIRES_USER",
            "text": "紅茶"
