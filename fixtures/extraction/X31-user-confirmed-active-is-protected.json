        ]
      }
    },
    {
      "op": "confirm",
      "candidate": "j1#0",
      "action": "admit",
      "expect": {
        "status": "admitted",
        "origin": "user_confirmed",
        "text": "紅茶"
      }
    },
    {
      "op": "list-state",
      "includeInactive": true,
      "expect": {
        "items": [
          {
            "semanticKey": "drink",
            "status": "superseded",
            "origin": "user_confirmed",
            "text": "コーヒー",
            "polarity": "affirmed"
          },
          {
            "semanticKey": "drink",
            "status": "active",
            "origin": "user_confirmed",
            "text": "紅茶",
            "polarity": "affirmed"
          }
        ]
      }
